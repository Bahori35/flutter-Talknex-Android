# ==============================================================================
# Talknex Go Ultra-Scalable Server Configuration (500k Kullanıcı Altyapısı)
# ==============================================================================

# 1. Sunucu Temel Ayarları
PORT=3001
JWT_SECRET=super_secret_jwt_key_talknex_2026

# 2. Veritabanı (MariaDB / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_app_db

# 3. Redis Pub/Sub Kümesi (Çoklu Sunucu Yük Dağıtımı & Gerçek Zamanlı Yönlendirme)
# Boş bırakılırsa tek sunucu (In-Memory) modunda çalışır, sunucu çökmez.
REDIS_ENABLED=auto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. S3 / Cloudflare R2 / MinIO Nesne Depolama (Medya & Dosyalar)
# Boş bırakılırsa yerel disk (/uploads) modunda çalışmaya devam eder.
S3_ENDPOINT=s3.eu-central-1.amazonaws.com
S3_BUCKET=talknex-media
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_REGION=eu-central-1
S3_PUBLIC_URL=https://cdn.talknex.com
S3_USE_SSL=true
